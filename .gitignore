# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# เครื่องมือพัฒนา (ก็อปปี้ติดตั้งในเครื่อง ไม่ต้อง commit)
.pytest_cache/
.ruff_cache/
.linttools/
.benchmarks/
*.egg-info/

# SoonAI secrets + cache (ห้าม commit key เด็ดขาด)
shared/keys.json
shared/.models_cache.json
shared/.machine_id
# config/team ระดับเครื่องอยู่ที่ DATA_DIR แล้ว (%LOCALAPPDATA%\SoonAI · ~/.soonai)
# สองชื่อนี้คือตำแหน่งเดิมใน source tree — เผื่อเครื่องใดยังมีร่างเก่าค้างอยู่
# (ensure_user_files() จะย้ายให้เอง) ห้าม commit เพราะเป็นค่าส่วนตัวของแต่ละเครื่อง
shared/config.json
shared/team.json
sessions/*.json
debug_last.json
crash.log
.env

# log ของโหมด debug (ปกติอยู่ที่ <DATA_DIR>/logs/ · เผื่อกรณี fallback มาโฟลเดอร์โปรเจค)
logs/
debug.log
debug.log.[0-9]*

# mcp.json = ค่าตั้งเฉพาะเครื่อง (พาธ node_modules ของผู้ใช้ + โฟลเดอร์ที่อนุญาต)
# ตัวโปรแกรมรันได้ปกติเมื่อไม่มีไฟล์นี้ (MCPHub อ่านไม่เจอ = ไม่มี server → _servers_from_file คืน {})
# เก็บ "ตัวอย่าง" ที่ไม่มีพาธส่วนตัวไว้ที่ shared/mcp.example.json แทน
shared/mcp.json

# ผลรันที่สร้างใหม่ได้ (python depgraph.py · eval_ambiguous.py)
.freebuff/arch.html
eval_results.json

# รหัสเฉพาะเครื่อง (ไม่เกี่ยวกับงาน)
.freebuff/project-id
